# Supabase Configuration
# Obtain these from your Supabase Dashboard: Settings -> API

# Publicly accessible Supabase URL (Used by client and server)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Publicly accessible Supabase Anon/Public Key (Safe to expose to the browser)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Privileged Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Optional: Used for elevated server-side operations if needed
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
